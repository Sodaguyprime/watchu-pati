# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here
# Everyone who opens the site with the same value shares one room
VITE_ROOM=change-me-to-a-long-random-string

# Optional: your site's address, for link previews (og:url / og:image)
SITE_URL=
# Optional: Android app loads this URL instead of the bundled build
CAP_SERVER_URL=
